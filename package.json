{
  "name": "dsh-usage-pill",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek 用量与余额：会话 token 用量、按每笔实际发生时刻与模型计价的费用（峰谷/档位）、账户余额（账号授权优先，API Key 兜底）",
  "author": "李敖 (oliblue)",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "assets",
    "README.md"
  ]
}
